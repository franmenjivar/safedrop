# SafeDrop credentials. Copy to `.env` and fill in. `.env` is gitignored.

# Google AI Studio key for the three PydanticAI agents and the vision tool.
# Free key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional: Google Maps Embed API key. With it, candidate cards render Street View
# inline; without it they link out to Google Maps instead. The Embed API is free and
# unmetered. This key is served to the browser by design — restrict it by HTTP referrer
# in the Google Cloud console. https://developers.google.com/maps/documentation/embed
GOOGLE_MAPS_EMBED_KEY=

# Optional overrides
# SAFEDROP_MODEL=google:gemini-2.5-flash
# SAFEDROP_CONTEXT_MODE=offline        # offline | hybrid | live
# SAFEDROP_VISION=stub                 # set to "stub" to use authored image facts instead of the vision model
